{
	"name": "@kaneo/mobile",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Capacitor shell that packages the TickTack web app as native iOS and Android apps.",
	"scripts": {
		"build:web": "pnpm --filter @kaneo/web build:native",
		"sync": "cap sync",
		"sync:android": "cap sync android",
		"sync:ios": "cap sync ios",
		"build": "pnpm run build:web && cap sync",
		"open:android": "cap open android",
		"open:ios": "cap open ios",
		"run:android": "cap run android",
		"run:ios": "cap run ios",
		"doctor": "cap doctor",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@capacitor/android": "8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "8.5.3",
		"@capacitor/ios": "8.5.3",
		"@capacitor/preferences": "^8.0.1"
	},
	"devDependencies": {
		"@capacitor/cli": "8.5.3",
		"typescript": "~7.0.2"
	}
}
