    <string name="shortcut_inbox_short">Inbox</string>

    <!-- Google Assistant grammar for the custom intents in shortcuts.xml.
         Assistant matches custom intents in en-US only; $text1 is the first
         text parameter of the intent, and the app name is implied. -->
    <string-array name="assistant_create_task_queries" translatable="false">
        <item>create a task called $text1</item>
        <item>create a task named $text1</item>
        <item>create a task $text1</item>
        <item>create a new task called $text1</item>
        <item>create a new task $text1</item>
        <item>add a task called $text1</item>
        <item>add a task named $text1</item>
        <item>add a task $text1</item>
        <item>add $text1 to my tasks</item>
        <item>new task $text1</item>
        <item>remind me to $text1</item>
        <item>create a task</item>
        <item>create a new task</item>
        <item>add a task</item>
        <item>new task</item>
    </string-array>
    <string-array name="assistant_start_timer_queries" translatable="false">
        <item>start a timer on $text1</item>
        <item>start a timer for $text1</item>
        <item>start the timer on $text1</item>
        <item>start tracking time on $text1</item>
        <item>start tracking $text1</item>
        <item>track time on $text1</item>
        <item>start working on $text1</item>
        <item>start a timer</item>
        <item>start the timer</item>
        <item>start tracking time</item>
    </string-array>
    <string-array name="assistant_stop_timer_queries" translatable="false">
        <item>stop the timer</item>
        <item>stop my timer</item>
        <item>stop tracking time</item>
        <item>stop tracking</item>
        <item>stop the clock</item>
        <item>stop working</item>
    </string-array>
    <string-array name="assistant_whats_next_queries" translatable="false">
        <item>what\'s next</item>
        <item>what is next</item>
        <item>what\'s next on my list</item>
        <item>what\'s on my plate</item>
        <item>what are my tasks</item>
        <item>show my tasks</item>
        <item>what should I do next</item>
        <item>what do I have to do</item>
        <item>what\'s due today</item>
        <item>what\'s due</item>
    </string-array>

