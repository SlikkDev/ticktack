    <string name="custom_url_scheme">io.slikk.ticktack</string>

    <!-- Launcher shortcuts (res/xml/shortcuts.xml). -->
    <string name="shortcut_new_task_short">New task</string>
    <string name="shortcut_new_task_long">Create a new task</string>
    <string name="shortcut_my_tasks_short">What\'s next</string>
    <string name="shortcut_my_tasks_long">See what\'s next on your list</string>
