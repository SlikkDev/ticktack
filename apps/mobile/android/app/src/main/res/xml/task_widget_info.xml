<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (widget/TaskWidgetProvider.java): 4x2 by default,
     resizable, refreshed by the launcher every 30 minutes and by the app on
     every sign-in and whenever the user leaves it. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_tasks"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_tasks_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
