    "pairing.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TickTack on your iPhone and sign in. Your tasks then appear here."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את טיקטק באייפון והתחברו. המשימות שלכם יופיעו כאן."
          }
        }
      }
    },
