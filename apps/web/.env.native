# Loaded by `vp build --mode native` (pnpm --filter @kaneo/web build:native).
# The Capacitor apps bundle this build, so nothing substitutes the nginx
# placeholders from .env.production at start-up: the API and client origins
# are baked in here. Override them in apps/web/.env.native.local (git-ignored),
# for example VITE_API_URL=http://10.0.2.2:1337 for the Android emulator.
VITE_API_URL=https://ticktack.slikk.io
VITE_CLIENT_URL=https://ticktack.slikk.io
